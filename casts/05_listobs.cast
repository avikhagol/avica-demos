[0.016186, "o", "\r\n\u001b[1m\u001b[0;33m━━━  AVICA — Observation Summary  ━━━\u001b[0m\r\n\r\n"]
[1.017477, "o", "\r\n\u001b[0;36m# Before running the pipeline it's useful to inspect what's in the data.\u001b[0m\r\n"]
