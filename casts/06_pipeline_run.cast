[3.953312, "o", "target_dir = reductions/\r\nfolder_for_fits = /mnt/6438D98627D1388F/Intelligence/jupyter/vscode/fitsfiles/\r\nsize_limit = 2000.0\r\nmpi_cores_rpicard = 10\r\nmpi_cores_snrating = 5\r\nmpi_cores_importfitsidi = 5\r\nsnr_threshold_phref = 7\r\nflux_threshold_phref = 0.15\r\ncasadir = /mnt/6438D98627D1388F/Intelligence/env/rPicard/casa-CAS-14268-5-py3.10-gpu.el8/\r\n"]
[6.954548, "o", "\r\n\u001b[0;36m# The pipeline has 9 calibration steps, run in sequence:\u001b[0m\r\n"]
[8.756007, "o", "\u001b[0;36m"]
[8.756564, "o", "\r\n  1. preprocess_fitsidi   — fix/validate FITS-IDI issues\r\n  2. fits_to_ms           — convert to CASA Measurement Set\r\n  3. phaseshift           — phase-shift to target position\r\n  4. avica_avg            — time/frequency averaging\r\n  5. avicameta_ms         — extract metadata from MS\r\n  6. avica_snr            — compute per-baseline SNR\r\n  7. avica_fill_input     — populate rPICARD input templates\r\n  8. avica_split_ms       — split calibrator / target MSes\r\n  9. rpicard              — run rPICARD calibration\r\n\r\n"]
[8.756614, "o", "\u001b[0m"]
[11.758002, "o", "\r\n\u001b[0;36m# Launch the full pipeline\u001b[0m\r\n"]
