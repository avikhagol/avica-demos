[0.008317, "o", "\r\n\u001b[1m\u001b[0;33m━━━  AVICA — Full Pipeline Run  ━━━\u001b[0m\r\n\r\n"]
[1.009943, "o", "\r\n\u001b[0;36m# Show the config we'll use\u001b[0m\r\n"]
