[0.016778, "o", "\r\n\u001b[1m\u001b[0;33m━━━  AVICA FITS-IDI Validation  ━━━\u001b[0m\r\n\r\n"]
[1.017932, "o", "\r\n\u001b[0;36m# FITS-IDI files from different correlators often carry subtle issues.\u001b[0m\r\n"]
[2.819854, "o", "\r\n\u001b[0;36m# avica fitsidi_check inspects every HDU against a library of known problems.\u001b[0m\r\n"]
