[23.120928, "o", "\u001b[1m                                                                                                                                                                                                        \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1;33mUsage: \u001b[0m\u001b[1mavica pipe run [OPTIONS] [steps]...\u001b[0m\u001b[1m                                                                                                                                                            \u001b[0m\u001b[1m \u001b[0m\r\n\u001b[1m                                                                                                                                                                                                        \u001b[0m\r\n"]
[23.123538, "o", " _______________________                                                                                                                                                                                \r\n                                                                                                                                                                                                        \r\n \u001b[2mpipeline steps:\u001b[0m                                                                                                                                                                                        \r\n \u001b[2m-   preprocess_fitsidi\u001b[0m                                                                                                                                                                                 \r\n \u001b[2m-   fits_to_ms\u001b[0m                                                                                                                                                                                         \r\n \u001b[2m-   phaseshift\u001b[0m                                                                                                                                                                                         \r\n \u001b[2m-   avica_avg\u001b[0m                                                                                                                                                                                          \r\n \u001b[2m-   avicameta_ms\u001b[0m                                                                                                                                                                                       \r\n \u001b[2m-   avica_snr\u001b[0m                                                                                                                                                                                          \r\n \u001b[2m-   avica_fill_input\u001b[0m                                                                                                                                                                                   \r\n \u001b[2m-   avica_split_ms\u001b[0m                                                                                                                                                                                     \r\n \u001b[2m-   rpicard\u001b[0m                                                                                                                                                                                            \r\n                                                                                                                                                                                                        \r\n                                                                                                                                                                                                        \r\n \u001b[2m________________________\u001b[0m                                                                                                                                                                               \r\n                                                                                                                                                                                                        \r\n"]
[23.125655, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Arguments \u001b[0m\u001b[2m─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m   steps      \u001b[1;2;33m<\u001b[0m\u001b[1;33mstr\u001b[0m\u001b[1;2;33m>\u001b[0m  steps for execution \u001b[2m[default: preprocess_fitsidi, fits_to_ms, avica_avg, avicameta_ms, avica_snr, avica_fill_input, avica_split_ms, rpicard]\u001b[0m                                     \u001b[2m│\u001b[0m\r\n\u001b[2m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[23.130938, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Options \u001b[0m\u001b[2m───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-f\u001b[0m,\u001b[1;36m-\u001b[0m\u001b[1;36m-fitsfilenames\u001b[0m         \u001b[1;2;33m<\u001b[0m\u001b[1;33mstr\u001b[0m\u001b[1;2;33m>\u001b[0m  fitsfile names comma separated                                                                                                                                    \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-t\u001b[0m,\u001b[1;36m-\u001b[0m\u001b[1;36m-target\u001b[0m                \u001b[1;2;33m<\u001b[0m\u001b[1;33mstr\u001b[0m\u001b[1;2;33m>\u001b[0m  Selected field / sourc name                                                                                                                                       \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-configfile\u001b[0m                \u001b[1;2;33m<\u001b[0m\u001b[1;33mstr\u001b[0m\u001b[1;2;33m>\u001b[0m  config file containing key=value \u001b[2m[default: avica.inp]\u001b[0m                                                                                                             \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-default\u001b[0m\u001b[1;36m-configfile\u001b[0m        \u001b[1;2;33m<\u001b[0m\u001b[1;33mstr\u001b[0m\u001b[1;2;33m>\u001b[0m  default config file name containing key=value \u001b[2m[default: avica.inp]\u001b[0m                                                                                                \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-resume\u001b[0m                    \u001b[1;33m     \u001b[0m  Resume after the last successful step in the result CSV.                                                                                                          \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-resume\u001b[0m\u001b[1;36m-from\u001b[0m               \u001b[1;2;33m<\u001b[0m\u001b[1;33mstr\u001b[0m\u001b[1;2;33m>\u001b[0m  Start from this pipeline step.                                                                                                                                    \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-help\u001b[0m                      \u001b[1;33m     \u001b[0m  Show this message and exit.                                                                                                                                       \u001b[2m│\u001b[0m\r\n\u001b[2m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[23.130969, "o", "\r\n"]
