[7.728332, "o", "\r\n"]
[8.545008, "o", "Usage: bash install.sh\r\nCASA_PATH: existing CASA directory or archive URL (prompted if unset).\r\nCASA_DIR and CASA_URL are also accepted, in that order.\r\nDefault CASA archive: ftp://ftp.mpifr-bonn.mpg.de/outgoing/mjanssen/casa-6.7.5-18-py3.12.el8.tar.xz\r\nAVICA_INSTALL_DIR: installation directory (default: ~/.local/share/avica-stack).\r\nAVICA_SOURCE_DIR: local AVICA source directory to install instead of the latest PyPI version.\r\nPICARD_REF: branch/tag for a new rPICARD clone (default: master).\r\n"]
[10.546872, "o", "\r\n\u001b[1m\u001b[0;33m━━━  Fresh installation  ━━━\u001b[0m\r\n\r\n"]
[11.548763, "o", "\r\n\u001b[0;36m# With no existing CASA, the installer downloads it and sets up rPICARD\u001b[0m\r\n"]
[13.350591, "o", "\r\n\u001b[0;36m# Just run install.sh — it will prompt for a CASA location if needed\u001b[0m\r\n"]
