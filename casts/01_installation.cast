[0.016142, "o", "\u001b[8;50;200t"]
[0.016867, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.017044, "o", "\r\n\u001b[1m\u001b[0;33m━━━  AVICA — Installation  ━━━\u001b[0m\r\n\r\n"]
[1.018295, "o", "\r\n\u001b[0;36m# install.sh sets up the full stack: avica, CASA, and rPICARD\u001b[0m\r\n"]
[2.8201, "o", "\r\n\u001b[0;36m# Run --help first to see the available options and environment variables\u001b[0m\r\n"]
