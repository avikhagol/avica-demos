[41.051311, "o", "\u001b[3m                                                                                AVICA parameter summary                                                                                 \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mStep              \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mParameter                     \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mSource          \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mValue                                                                                                      \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\n│\u001b[1;36m \u001b[0m\u001b[1;36mpreprocess_fitsidi\u001b[0m\u001b[1;36m \u001b[0m│ lf                             │ \u001b[33mdefault         \u001b[0m │ \u001b[33m<avica.pipe.config.LogFramework object at 0x7fb3dd0c4dc0>                                                  \u001b[0m │\r\n│\u001b[1;36m \u001b[0m\u001b[1;36m                  \u001b[0m\u001b[1;36m \u001b[0m│ fitsfiles                      │ \u001b[31mrequired/runtime\u001b[0m │ \u001b[31mNone                                                                                                       \u001b[0m │\r\n│\u001b[1;36m \u001b[0m\u001b[1;36m                  \u001b[0m\u001b[1;36m \u001b[0m│ target                         │ \u001b[31mrequired/runtime\u001b[0m │ \u001b[31mNone                                                                                                       \u001b[0m │\r\n│\u001b[1;36m \u001b[0m\u001b[1;36m                  \u001b[0m\u001b[1;36m \u001b[0m│ wd_ifolder                     │ \u001b[31mrequired/runtime\u001b[0m │ \u001b[31mNone                                                                                                       \u001b[0m │\r\n│\u001b[1;36m \u001b[0m\u001b[1;36m                  \u001b[0m\u001b[1;36m \u001b[0m│ source_extract_multi_fitsfiles │ \u001b[33mdefault         \u001b[0m │ \u001b[33mFalse                                                                                                      \u001b[0m │\r\n│\u001b[1;36m \u001b[0m\u001b[1;36m                  \u001b[0m\u001b[1;36m \u001b[0m│ removables                     │ \u001b[33mdefault         \u001b[0m │ \u001b[33m['raw/*.tmp']                                                                                              \u001b[0m │\r\n│\u001b[1;36m \u001b[0m\u001b[1;36m                  \u001b[0m\u001b[1;36m \u001b[0m│ rm_only                        │ \u001b[33mdefault         \u001b[0m │ \u001b[33mFalse                                                                                                      \u001b[0m │\r\n│\u001b[1;36m \u001b[0m\u001b[1;36m                  \u001b[0m\u001b[1;36m \u001b[0m│ rm_pre                         │ \u001b[33mdefault         \u001b[0m │ \u001b[33mFalse                                                                                                      \u001b[0m │\r\n│\u001b[1;36m \u001b[0m\u001b[1;36m                  \u001b[0m\u001b[1;36m \u001b[0m│ delete_removables              │ \u001b[33mdefault         \u001b[0m │ \u001b[33mFalse                                                                                                      \u001b[0m │\r\n│\u001b[1;36m \u001b[0m\u001b[1;36m                  \u001b[0m\u001b[1;36m \u001b[0m│ verbose                        │ \u001b[33mdefault         \u001b[0m │ \u001b[33mFalse                                                                                                      \u001b[0m │\r\n├─────────"]
